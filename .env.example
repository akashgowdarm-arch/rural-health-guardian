# ==============================================================================
# RURAL HEALTH GUARDIAN - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Base URL for the FastAPI Backend API
# For local development with Python backend: http://localhost:8000
# For deployment: set to your deployed backend URL or leave empty for same-origin
VITE_API_URL=http://localhost:8000
PUBLIC_API_BASE_URL=http://localhost:8000
PORT=8000
HOST=0.0.0.0

# ==============================================================================
# SUPABASE CONFIGURATION
# ==============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==============================================================================
# GOOGLE GEMINI CONFIGURATION
# ==============================================================================
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
