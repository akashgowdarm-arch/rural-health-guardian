{
  "name": "launchflow-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "agent"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@launchflow/api & npm run dev --workspace=@launchflow/web",
    "dev:api": "npm run dev --workspace=@launchflow/api",
    "dev:web": "npm run dev --workspace=@launchflow/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace=@launchflow/api"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "~5.7.2"
  }
}
