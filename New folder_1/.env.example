# LaunchFlow Environment Configuration

# Database & Cache
DATABASE_URL="postgresql://launchflow:launchflow_secret@localhost:5432/launchflow_db"
REDIS_URL="redis://localhost:6379"

# GitHub OAuth Integration
GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"

# Application URLs & Routing
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
DEPLOYMENT_DOMAIN="launchflow.app"

# Security & Secrets Encryption (32-byte hex string for AES-256-GCM)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
JWT_SECRET="launchflow_production_jwt_secret_key"
